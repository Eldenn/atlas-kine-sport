# Contact form: Hostinger Mail API, read by the server only (never prefix with VITE_).
# Token: hPanel → Emails → Agentic Mail → API access.
HOSTINGER_MAIL_API_TOKEN=
# Resource ID of the mailbox that sends (GET https://api.mail.hostinger.com/api/v1/me lists it).
HOSTINGER_MAILBOX_ID=
# Where messages arrive; several addresses separated by commas.
CONTACT_TO=
